{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/d/vmem-pitch",
      "destination": "/slides/intro-to-vmem",
      "permanent": false
    },
    { "source": "/d/:id", "destination": "/slides/:id", "permanent": false },
    { "source": "/decks", "destination": "/slides", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!media/|assets/|fonts/).*)", "destination": "/index.html" }
  ]
}
