{
  "name": "remotion-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter backend typecheck",
    "codegen": "pnpm --filter backend codegen",
    "remotion:studio": "pnpm --filter web remotion:studio",
    "render:deck": "pnpm --filter web render:deck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
